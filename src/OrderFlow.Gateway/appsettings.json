{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PerMinute": 120
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/orders/{**rest}" }
      },
      "products": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/products/{**rest}" }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": { "d1": { "Address": "http://orders" } }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalog" } }
      }
    }
  }
}
